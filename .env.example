# Template — safe to commit. Copy to `.env` and put your real value there.
#   cp .env.example .env
#
# Read by drizzle-kit (db:push) and the seed script (db:seed), which run in
# Node and never see Wrangler's bindings.
#
# Get this from https://neon.com -> your project -> Connect -> copy the
# POOLED connection string (the host contains "-pooler").
#
# NOTE: never put a real credential in this file — .env.example IS committed.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
