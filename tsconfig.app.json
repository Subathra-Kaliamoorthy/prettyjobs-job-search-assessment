{
  // Browser. No `node` types here, so `process.env` in a component is a
  // compile error rather than a runtime ReferenceError in the browser.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "shared"]
}
